@model IEnumerable<BlogApp.Models.Article>

<h2 id="contributorDashboardTitle">Your Articles</h2>

<table id="contributorArticleTable" class="article-table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Created On</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var article in Model)
    {
        <tr>
            <td>
                <span class="article-title">@article.Title</span>
                <div class="article-body-preview">
                    @Html.Raw(article.Body.Substring(0, Math.Min(100, article.Body.Length)))
                    <a href="@Url.Action("Article", "Home", new { id = article.ArticleId })" class="read-more">More...</a>
                </div>
            </td>
            <td class="article-date">@article.StartDate.ToShortDateString()</td>
            <td class="article-date">@article.EndDate.ToShortDateString()</td>
            <td class="article-date">@article.CreateDate.ToString("MMMM dd, yyyy HH:mm")</td> <!-- Display CreateDate -->
            <td class="actions-cell">
                <a href="/Contributor/EditArticle/@article.ArticleId" class="edit-link">Edit</a> 
                <form asp-action="DeleteArticle" method="post" style="display:inline;">
                    <input type="hidden" name="id" value="@article.ArticleId" />
                    <button type="submit" class="delete-button">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>

<a id="createNewArticleBtn" class="create-article-btn" href="/Contributor/CreateArticle">Create New Article</a>
