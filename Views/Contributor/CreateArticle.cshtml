@model BlogApp.Models.Article

<h2>Create Article</h2>

<form id="createArticleForm" asp-action="CreateArticle" method="post">
    <div class="create-form-group">
        <label for="title">Title:</label>
        <input type="text" id="createTitle" name="Title" value="@Model?.Title" required />
    </div>

    <div class="create-form-group">
        <label for="body">Body:</label>
        <textarea id="createBody" name="Body" required>@Model?.Body</textarea>
    </div>

    <div class="create-form-group">
        <label for="startDate">Start Date:</label>
        <input type="date" id="createStartDate" name="StartDate"
            value="@(Model?.StartDate != null ? Model.StartDate.ToString("yyyy-MM-dd") : "")" required />
    </div>

    <div class="create-form-group">
        <label for="endDate">End Date:</label>
        <input type="date" id="createEndDate" name="EndDate"
            value="@(Model?.EndDate != null ? Model.EndDate.ToString("yyyy-MM-dd") : "")" required />
    </div>

    @if (Model?.CreateDate != DateTime.MinValue)
    {
        <div class="create-form-group">
            <label>Created On:</label>
            <span>@Model.CreateDate.ToString("MMMM dd, yyyy HH:mm")</span>
        </div>
    }

    <button type="submit" class="create-submit-btn">Create</button>
</form>
