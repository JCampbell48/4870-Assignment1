@model BlogApp.Models.Article

<h2>Edit Article</h2>

<form id="editArticleForm" asp-action="EditArticle" method="post">
    <input type="hidden" name="ArticleId" value="@Model.ArticleId" />

    <div class="edit-form-group">
        <label for="title">Title:</label>
        <input type="text" id="editTitle" name="Title" value="@Model.Title" required />
    </div>

    <div class="edit-form-group">
        <label for="body">Body:</label>
        <textarea id="editBody" name="Body">@Model.Body</textarea>
    </div>

    <div class="edit-form-group">
        <label for="startDate">Start Date:</label>
        <input type="date" id="editStartDate" name="StartDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" required />
    </div>

    <div class="edit-form-group">
        <label for="endDate">End Date:</label>
        <input type="date" id="editEndDate" name="EndDate" value="@Model.EndDate.ToString("yyyy-MM-dd")" required />
    </div>

    <button type="submit" class="edit-submit-btn">Save Changes</button>
</form>
