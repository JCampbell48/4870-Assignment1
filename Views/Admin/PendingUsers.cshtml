@model List<BlogApp.Models.User>

<h2>Pending Users</h2>

@if (Model.Any())
{
    <table>
        <thead>
            <tr>
                <th>Username</th>
                <th>Email</th>
                <th>Approve</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.UserName</td>
                <td>@user.Email</td>
                <td>
                    <form method="post" asp-action="ApproveUser" asp-route-id="@user.Id">
                        <button type="submit">Approve</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <p>No pending users.</p>
}
